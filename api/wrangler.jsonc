{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "lotero-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lotero",
      "database_id": "d9af300e-4c0c-4393-82d0-a7357cc38a05",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    // Disparan el workflow de GitHub que recoge los premios (ver src/disparo.ts).
    // 22:00 UTC, tras los sorteos de las 21:00 en España; 07:00 UTC, recuperación.
    "crons": ["0 22 * * *", "0 7 * * *"]
  },
  "vars": {
    // Orígenes autorizados por CORS, separados por comas.
    "ORIGENES_PERMITIDOS": "https://www.juegosonce.es,https://ogires.github.io",
    // Workflow que dispara el cron.
    "GITHUB_REPO": "Ogires/lotero",
    "GITHUB_WORKFLOW": "actualizar.yml",
    "GITHUB_RAMA": "main"
  }
}

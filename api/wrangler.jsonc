{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "lotero-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lotero",
      // Marcador para desarrollo local: se sustituye por el ID real al crear la base (fase 3).
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // Orígenes autorizados por CORS, separados por comas.
    "ORIGENES_PERMITIDOS": "https://www.juegosonce.es"
  }
}

{
  "name": "@lotero/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "cf-typegen": "wrangler types",
    "typecheck": "wrangler types && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "vitest run --config vitest.live.config.ts",
    "db:migrate:local": "wrangler d1 migrations apply lotero --local"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.4",
    "vitest": "4.1.12",
    "wrangler": "4.151.1"
  }
}

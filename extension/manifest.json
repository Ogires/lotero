{
  "manifest_version": 3,
  "name": "Lotero: ¿ya ha salido premiado este número?",
  "short_name": "Lotero",
  "version": "1.0.0",
  "description": "Comprueba en juegosonce.es si el número del cupón ya ha salido premiado en la ONCE o en la Lotería Nacional. No oficial.",
  "icons": {
    "16": "iconos/icono-16.png",
    "32": "iconos/icono-32.png",
    "48": "iconos/icono-48.png",
    "128": "iconos/icono-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.juegosonce.es/cupon-diario*",
        "https://www.juegosonce.es/cuponazo*",
        "https://www.juegosonce.es/sueldazo-fin-de-semana*"
      ],
      "js": ["contenido.js"],
      "run_at": "document_idle"
    }
  ]
}

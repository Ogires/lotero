{
    "manifest_version": 2,
    "name": "lotero",
    "description": "Consulta si un número de lotería propuesto en juegosonce.es ha sido premiado anteriormente en sorteos de la Once o la Lotería Nacional",
    "version": "0.1",
    "author": "Sergio Bonet",
    "browser_action": {
        "default_icon": "icon.png",
        "default_title": "Lotero"
    },
    "content_scripts": [
        {
            "matches": [
                "https://*.juegosonce.es/*"
            ],
            "css": [
                "style.css",
                "node_modules/jquery-modal/jquery.modal.min.css"
            ],
            "js": [
                "handlebars-v4.1.1.js",
                "plantilla.js",
                "elmodal.js",
                "jquery-3.3.1.js",
                "node_modules/jquery-modal/jquery.modal.min.js",                
                "contentScript.js"
            ]
        }
    ],
    "web_accessible_resources": [
        "images/eye.svg",
        "images/eye-slash.svg",
        "images/logo-once.png",
        "images/logo-lne.png"
    ],
    "permissions": [
        "activeTab",
        "https://loto-chanante.appspot.com/*",
        "http://loto-chanante.appspot.com/*"
    ]
}
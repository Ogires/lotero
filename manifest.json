{
    "manifest_version": 2,
    "name": "checkMyNumber",
    "description": "Consulta si un número de lotería ha sido premiado en los sorteos de la Once o la Lotería Nacional",
    "version": "1.0",
    "author": "Sergio Bonet",
    "browser_action": {
        "default_icon": "icon.png",
        "default_title": "Check my number"
    },
    "content_scripts": [
        {
            "matches": [
                "https://*.juegosonce.es/*"
            ],
            "css": [
                "style.css"
            ],
            "js": [
                "jquery-3.3.1.js",
                "contentScript.js"
            ]
        }
    ],
    "web_accessible_resources": [
        "eye.svg"
    ],
    "permissions": [
        "activeTab",
        "https://loto-chanante.appspot.com/*",
        "http://loto-chanante.appspot.com/*"
    ]
}